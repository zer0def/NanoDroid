#!/system/bin/sh

umask 022
OUTFD="${2}"
ZIP="${3}"

MODID=NanoDroid_AOSmiumWebView

mkdir -p /dev/tmp
unzip -oq "${ZIP}" CommonInstaller -d "/dev/tmp"
if [ ! -f /dev/tmp/CommonInstaller ]; then
	echo " !! failed to load Common Installer"
	exit 1
else
	source "/dev/tmp/CommonInstaller"
fi

setup_installer 1

## https://axpos.org/docs/knowledge/signatures/#axpos-app-signature
#export WEBVIEW_SIG=""
WEBVIEW_PKG="org.axpos.aosmium_wv" WEBVIEW_DESC="AOSmium WebView" WEBVIEW_SIG="" install_webview
set_progress 0.75

nanodroid_finalize
set_progress 1.0

exit 0
