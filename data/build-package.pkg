#!/bin/bash

create_full_package () {
	ZIP="NanoDroid-${VERSION}.zip"

	print_package "Full"

	zip_add Full
	zip_add_setup 1

	sum_sign_package "${ZIP}"
}

mk_pkg_full () {
	create_full_package
}

create_webview_package () {
	ZIP="NanoDroid-${1}-${VERSION}.zip"

	print_package "${1}"

	zip_add "${1}"
	zip_add_setup 0

	sum_sign_package "${ZIP}"
}

mk_pkg_aosmium_webview () {
	create_webview_package AOSmiumWebView
}

mk_pkg_bromite_webview () {
	create_webview_package BromiteWebView
}

mk_pkg_cromite_webview () {
	create_webview_package CromiteWebView
}

mk_pkg_mulch_webview () {
	create_webview_package MulchWebView
}

create_uninstaller_package() {
	ZIP="NanoDroid-uninstaller-${VERSION}.zip"

	print_package "Uninstaller"

	zip_add uninstaller

	sum_sign_package "${ZIP}"
}

mk_pkg_uninstaller () {
	create_uninstaller_package
}

create_systest_package() {
	ZIP="NanoDroid-systest-${VERSION}.zip"

	print_package "SysTest"

	zip_add systest

	sum_sign_package "${ZIP}"
}

mk_pkg_systest () {
	create_systest_package
}
